# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/plataforma_colombiana"

# NextAuth.js Configuration
NEXTAUTH_SECRET="your-super-secret-key-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# External APIs
WEATHER_API_KEY="your-weather-api-key"

# ExchangeRate-API Configuration
# Free tier: Leave empty or remove this variable to use https://open.exchangerate-api.com
# Paid tier: Add your API key from https://www.exchangerate-api.com to use paid endpoints
# The free tier has no authentication and works out of the box
EXCHANGE_RATE_API_KEY=""

YOUTUBE_API_KEY="your-youtube-api-key"
TRANSLATION_PROVIDER="deepl" # deepl | libre | openai
TRANSLATION_API_KEY="your-translation-api-key"
TRANSLATION_BASE_URL="" # optional override for LibreTranslate/self-hosted

# ─────────────────────────────────────────────────────────────────────────────
# Sports API (active primary provider: API-Football v3 / api-sports.io)
# Docs: https://www.api-football.com/documentation-v3
# ─────────────────────────────────────────────────────────────────────────────
SPORTS_API_PROVIDER="api-football"
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
# Required: your API-Football key (get one at https://dashboard.api-football.com)
API_FOOTBALL_KEY="your-api-football-key"
# Set to "true" if you consume via RapidAPI proxy instead of api-sports.io
API_FOOTBALL_USE_RAPIDAPI="false"
API_FOOTBALL_HOST="api-football-v1.p.rapidapi.com"
# Backwards-compatible alias (fallback if API_FOOTBALL_KEY is not set)
SPORTS_API_KEY=""

# Default timezone for fixtures (IANA tz)
SPORTS_DEFAULT_TIMEZONE="America/Bogota"
# Default 4-digit season; empty = auto (LatAm calendar year, Europe Aug–Jul).
# Only set this to force a specific season globally (e.g. debugging).
SPORTS_DEFAULT_SEASON=""

# ── League IDs (API-Football v3) ────────────────────────────────────────────
# Latinoamérica (prioridad)
LEAGUE_COLOMBIA_ID="239"      # Liga BetPlay (Primera A)
LEAGUE_ARGENTINA_ID="128"     # Liga Profesional Argentina
LEAGUE_BRAZIL_ID="71"         # Brasileirão Série A
LEAGUE_MEXICO_ID="262"        # Liga MX
LEAGUE_CHILE_ID="265"         # Primera División (Chile)
LEAGUE_URUGUAY_ID="268"       # Primera División (Uruguay)
LEAGUE_PERU_ID="281"          # Liga 1 (Perú)
LEAGUE_ECUADOR_ID="242"       # LigaPro (Ecuador)
LEAGUE_PARAGUAY_ID="284"      # Primera División (Paraguay)
LEAGUE_BOLIVIA_ID="344"       # División Profesional (Bolivia)
LEAGUE_VENEZUELA_ID="299"     # Primera División (Venezuela)
LEAGUE_LIBERTADORES_ID="13"   # CONMEBOL Libertadores
LEAGUE_SUDAMERICANA_ID="11"   # CONMEBOL Sudamericana

# Europa
LEAGUE_SPAIN_ID="140"         # LaLiga
LEAGUE_ENGLAND_ID="39"        # Premier League
LEAGUE_ITALY_ID="135"         # Serie A
LEAGUE_GERMANY_ID="78"        # Bundesliga
LEAGUE_FRANCE_ID="61"         # Ligue 1
LEAGUE_PORTUGAL_ID="94"       # Primeira Liga
LEAGUE_NETHERLANDS_ID="88"    # Eredivisie
LEAGUE_CHAMPIONS_ID="2"       # UEFA Champions League
LEAGUE_EUROPA_ID="3"          # UEFA Europa League
LEAGUE_CONFERENCE_ID="848"    # UEFA Europa Conference League

# Optional API-Football widget (client-side embeds)
NEXT_PUBLIC_API_FOOTBALL_WIDGET_KEY=""
NEXT_PUBLIC_API_FOOTBALL_WIDGET_MODE="iframe"
NEXT_PUBLIC_API_FOOTBALL_WIDGET_REFRESH="60"
NEXT_PUBLIC_API_FOOTBALL_WIDGET_VERSION="1.1.8"

# National team IDs (API-Football v3 team IDs)
TEAM_COLOMBIA_ID=""
TEAM_ARGENTINA_ID=""
TEAM_BRAZIL_ID=""
TEAM_MEXICO_ID=""
TEAM_SPAIN_ID=""
TEAM_ENGLAND_ID=""
TEAM_GERMANY_ID=""

# Security Configuration
BCRYPT_ROUNDS="12"
JWT_SECRET="your-jwt-secret-key-minimum-32-characters"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"

# Application Configuration
NODE_ENV="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Email Configuration (for notifications)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"

# File Upload Configuration
MAX_FILE_SIZE="5242880"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Monitoring and Logging
LOG_LEVEL="info"
SENTRY_DSN="your-sentry-dsn"

# Forum Configuration
OPENAI_API_KEY="your-openai-api-key" # For content moderation
FORUM_MODERATION_THRESHOLD="0.7"
FORUM_MAX_POSTS_PER_DAY="50"
FORUM_MAX_POSTS_PER_MINUTE="10"
FORUM_MAX_REPORTS_PER_HOUR="5"
CRON_SECRET="your-cron-secret-key" # Secret for cron job authentication
