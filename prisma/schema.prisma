generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "rhel-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  nickname      String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Campos para configuración de usuario
  phoneNumber   String?
  dateOfBirth   DateTime?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  reputation    Int       @default(0)
  lastLoginAt   DateTime?
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  // Evidencia de aceptación legal (auditoría y compliance)
  contractAcceptedAt DateTime? // Timestamp exacto de aceptación
  contractVersion    String? // Versión del Contrato de Usuario aceptado
  termsVersion       String? // Versión de los Términos de Uso aceptados
  privacyVersion     String? // Versión de la Política de Privacidad aceptada
  acceptanceIp       String? // IP desde la cual aceptó
  acceptanceUa       String? // User-Agent del navegador al aceptar

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  auditLogs      AuditLog[]
  businesses     Business[]
  forumComments  ForumComment[]
  forumPosts     ForumPost[]
  moderationLogs ModerationLog[]
  reports        Report[]
  reviews        Review[]
  sessions       Session[]

  @@index([email])
  @@index([nickname])
  @@index([isActive])
  @@index([isBanned])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Modelo para la recuperación de contraseñas
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Business {
  id               String       @id @default(cuid())
  name             String
  description      String
  city             String?
  phone            String
  email            String
  website          String?
  whatsapp         String?
  instagram        String?
  facebook         String?
  images           String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ownerId          String
  address          String?
  isActive         Boolean      @default(true)
  isVerified       Boolean      @default(false)
  latitude         Float?
  logoUrl          String?
  longitude        Float?
  plan             BusinessPlan @default(FREE)
  ranking          Int          @default(0)
  slug             String       @unique
  state            String?
  tiktok           String?
  category         String
  verificationDocs Json? // URLs de RUT, Cámara de Comercio, etc.
  adminNotes       String? // Notas internas del moderador
  moderationStatus String       @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products         Product[]
  reports          Report[]
  reviews          Review[]

  @@index([city])
  @@index([category])
  @@index([plan])
  @@index([moderationStatus])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float?
  currency    String   @default("COP")
  image       String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([featured])
  @@index([businessId])
}

model Forum {
  id          String      @id @default(cuid())
  name        String
  description String
  slug        String      @unique
  topic       ForumTopic
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  posts       ForumPost[]

  @@index([topic])
  @@index([isActive])
  @@index([startDate])
  @@index([isArchived])
}

model ForumPost {
  id              String         @id @default(cuid())
  content         String
  isEdited        Boolean        @default(false)
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?      // Timestamp for soft delete retention policy (hard delete after 30 days)
  isFlagged       Boolean        @default(false)
  flagReason      String?
  moderationScore Float?
  likesCount      Int            @default(0)
  reportsCount    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  authorId        String
  forumId         String
  comments        ForumComment[]
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  forum           Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  reports         Report[]

  @@index([forumId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFlagged])
  @@index([isDeleted])
  @@index([deletedAt])
}

model ForumComment {
  id              String    @id @default(cuid())
  content         String
  isEdited        Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? // Timestamp for soft delete retention policy (hard delete after 30 days)
  isFlagged       Boolean   @default(false)
  flagReason      String?
  moderationScore Float?
  likesCount      Int       @default(0)
  reportsCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  authorId        String
  postId          String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post            ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports         Report[]

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFlagged])
  @@index([isDeleted])
  @@index([deletedAt])
}

model Report {
  id         String        @id @default(cuid())
  reason     ReportReason
  details    String?       @db.Text
  status     ReportStatus  @default(PENDING)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  reporterId String
  postId     String?
  commentId  String?
  reviewId   String?
  businessId String?
  comment    ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post       ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  review     Review?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  business   Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId]) // Un usuario solo puede reportar una reseña una vez
  @@index([status])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
  @@index([reviewId])
  @@index([businessId])
  @@index([createdAt])
}

// Integración con n8n y herramientas externas
model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique // Se almacenará hasheada en producción
  name        String // Ej: "n8n-prod", "script-mantenimiento"
  permissions String[] // Ej: ["READ_USERS", "WRITE_BUSINESS", "MODERATE_REVIEWS"]
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String

  @@index([key])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([userId])
}

model SecurityLog {
  id        String   @id @default(cuid())
  event     String
  severity  String
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
  userId    String?

  @@index([event])
  @@index([severity])
  @@index([createdAt])
  @@index([ip])
}

enum UserRole {
  USER
  BUSINESS_OWNER
  MODERATOR
  ADMIN
}

enum Category {
  GASTRONOMIA
  TECNOLOGIA
  ARTESANIAS
  SERVICIOS
  MODA
  AGRICULTURA
  TURISMO
  SALUD
  EDUCACION
  CONSTRUCCION
  TRANSPORTE
  ENTRETENIMIENTO
  OTROS
}

enum ForumTopic {
  DAILY_1
  DAILY_2
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum BusinessPlan {
  FREE
  BASIC
  PREMIUM
  SPONSOR
}

// Auditoría de moderación de reseñas (defensa legal)
model ModerationLog {
  id        String   @id @default(cuid())
  action    String // "HIDE", "RESTORE", "ARCHIVE", "FLAG"
  reason    String?
  createdAt DateTime @default(now())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  moderatorId String
  moderator   User   @relation(fields: [moderatorId], references: [id])

  @@index([reviewId])
  @@index([moderatorId])
  @@index([createdAt])
  @@index([action])
}

// Estado de moderación de reseñas
enum ReviewStatus {
  VISIBLE // Visible al público (default)
  HIDDEN // Oculta manualmente por admin
  FLAGGED // Oculta automáticamente por reportes (En Revisión)
  ARCHIVED // Eliminada pero guardada en histórico
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campos de control de moderación
  status      ReviewStatus @default(VISIBLE)
  reportCount Int          @default(0)

  // Relación con el Negocio
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relación con el Usuario (Autor)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con reportes y auditoría
  reports Report[]
  logs    ModerationLog[]

  @@unique([businessId, userId]) // Un usuario solo puede dejar 1 reseña por negocio
  @@index([businessId])
  @@index([userId])
  @@index([status])
}
